{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/urbanland-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  
  "Jwt": {
    "SecretKey": "",
    "Issuer": "UrbanLandscape",
    "Audience": "UrbanLandscape.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Identity": {
    "RequireConfirmedEmail": false,
    "PasswordMinLength": 8,
    "PasswordRequireDigit": true,
    "PasswordRequireNonAlphanumeric": false,
    "MaxFailedLoginAttempts": 5
  },

  "ConnectionStrings": {
    "Identity": "",
    "ProjectManagement": "",
    "SceneDesign": "",
    "AssetCatalog": ""
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "UsePostgres": true
  },

  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "",
    "InstanceName": "UrbanLandscape"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
