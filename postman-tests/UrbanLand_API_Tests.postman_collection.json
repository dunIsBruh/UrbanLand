    {
      "name": "Admin",
      "description": "Admin operations using the seed admin account. Tests user listing, role promotion, and authorization checks.",
      "item": [
        {
          "name": "2.1 Login as Admin",
          "auth": null,
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"User exists\", () => pm.expect(j.user.id).to.not.be.empty);",
                  "pm.collectionVariables.set(\"adminAccessToken\", j.accessToken);",
                  "pm.collectionVariables.set(\"adminRefreshToken\", j.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminSeedEmail}}\",\n  \"password\": \"{{adminSeedPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2.2 Get All Users",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "  var j = pm.response.json();",
                  "  pm.test(\"Returns array of users\", () => {",
                  "    pm.expect(j).to.be.an(\"array\");",
                  "    pm.expect(j.length).to.be.at.least(1);",
                  "  });",
                  "  pm.collectionVariables.set(\"_adminAvailable\", \"true\");",
                  "  console.log(\"[Admin] Admin access confirmed\");",
                  "} else {",
                  "  pm.test(\"Status is 403 (admin role not available)\", () => pm.expect(pm.response.code).to.eql(403));",
                  "  pm.collectionVariables.set(\"_adminAvailable\", \"false\");",
                  "  console.log(\"[Admin] Admin role not available - skipping admin operations\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users"]
            }
          }
        },
        {
          "name": "2.3 Register User for Promotion",
          "auth": null,
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set(\"promoteUserId\", j.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoteEmail}}\",\n  \"displayName\": \"Promote Target\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2.4 Set User Role to Admin",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get(\"_adminAvailable\") === \"true\") {",
                  "  pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "  var j = pm.response.json();",
                  "  pm.test(\"Role changed to Admin\", () => pm.expect(j.role).to.eql(\"Admin\"));",
                  "} else {",
                  "  pm.test(\"Skipped - admin not available\", () => pm.expect(true).to.be.true);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{promoteUserId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "{{promoteUserId}}", "role"]
            }
          }
        },
        {
          "name": "2.5 Set Role Without Admin Rights (Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 403 Forbidden\", () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/users/{{promoteUserId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "users", "{{promoteUserId}}", "role"]
            }
          }
        }
      ]
    },
