{
  "info": {
    "name": "UrbanLand API Tests",
    "description": "Fully automated API test suite for UrbanLand backend. Covers Auth, Admin, Projects, Scenes, Assets, and Invitations with both happy-path and error-case tests.\n\n## Running\n### One-click (requires Node.js + Newman):\n  .\\run-tests.ps1\n\n### Manual (in Postman):\n  Import collection + environment. Set {{baseUrl}}. Run folder-by-folder or use Collection Runner.\n\n## Test Data Flow\n  1. Auth → registers urbantest.main, tests login/refresh/profile/password\n  2. Admin → logs seed admin, promotes a user\n  3. Projects → creates project, settings, invitation\n  4. Scenes → imports asset, creates scene, places/moves/removes objects\n  5. Assets → queries and verifies asset catalog\n  6. Invitations → second user registers and accepts invite\n\n## Variables\n  {{accessToken}}      — main user JWT\n  {{adminAccessToken}}  — admin JWT\n  {{secondAccessToken}} — second user JWT\n  {{projectId}} / {{sceneId}} / {{sceneObjectId}} — created during run",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('_setupDone')) {",
          "  var s = Date.now();",
          "  pm.collectionVariables.set('_testSuffix',   s);",
          "  pm.collectionVariables.set('testEmail',     'urbantest.' + s + '@example.com');",
          "  pm.collectionVariables.set('secondEmail',   'urbantest.' + s + '.second@example.com');",
          "  pm.collectionVariables.set('promoteEmail',  'urbantest.' + s + '.promote@example.com');",
          "  pm.collectionVariables.set('_setupDone',    'true');",
          "  console.log('[Setup] Unique suffix: ' + s);",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "userRole", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "secondAccessToken", "value": "" },
    { "key": "secondRefreshToken", "value": "" },
    { "key": "secondUserId", "value": "" },
    { "key": "promoteUserId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "sceneId", "value": "" },
    { "key": "sceneObjectId", "value": "" },
    { "key": "inviteCode", "value": "" },
    { "key": "importedAssetId", "value": "" },
    { "key": "testAssetId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Registration, login, token refresh, profile update, password change, and logout. Error cases for invalid email and wrong password.",
      "item": [
        {
          "name": "1.1 Register - Success",
          "auth": null,
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"Has tokens + user\", () => {",
                  "  pm.expect(j.accessToken).to.not.be.empty;",
                  "  pm.expect(j.user).to.not.be.undefined;",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", j.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", j.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", j.user.id);",
                  "pm.collectionVariables.set(\"userRole\", j.user.role);",
                  "pm.test(\"Role is User\", () => pm.expect(j.user.role).to.eql(\"User\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"displayName\": \"Test User\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
